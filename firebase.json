{
  "hosting": {
    "public": "site/dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "//": "General case first: header rules are matched against the REQUEST path, and cleanUrls means",
        "//2": "requests have no .html extension \u2014 so a `**/*.@(html)` rule matches nothing and pages were",
        "//3": "silently cached for an hour. Pages are the default here; assets override below.",
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          }
        ]
      },
      {
        "//": "Later rules win on a duplicate key. Assets are not content-hashed, so an hour \u2014 not a year.",
        "source": "/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "//": "`**` does not match the empty root path, so / kept Firebase's default hour. Name it explicitly.",
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "//": "Readable in a browser, so people can inspect the script before piping it to a shell.",
        "source": "/install",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "//": "Release artefacts are immutable once published \u2014 a given version's tarball never changes.",
        "source": "/releases/*.tar.gz",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/gzip"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "//": "`latest` and the checksums move with every release, so they must never be cached.",
        "source": "/releases/@(latest|SHA256SUMS)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
