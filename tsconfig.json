{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "paths": {
      "@fishtea/spec": ["./packages/spec/src/index.ts"],
      "@fishtea/core": ["./packages/core/src/index.ts"],
      "@fishtea/tui": ["./packages/tui/src/index.tsx"],
      "@fishtea/bench": ["./packages/bench/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx", "packages/*/test/**/*.ts"],
  "exclude": ["node_modules", "packages/ui"]
}
