# Core and UI share one image and one dependency install; the service picks a stage with `target:`.
# Name the stages explicitly: a build with no target gets the *last* stage, which is how the core service
# once ended up running Vite.
# The Bun this framework is tested on: .bun-version, which CI reads too. scripts/pins.test.ts holds them together.
ARG BUN_VERSION=1.4.2
FROM oven/bun:${BUN_VERSION} AS base
WORKDIR /fishtea
COPY package.json bun.lock* tsconfig.json ./
COPY packages ./packages
# builtin plugins: the ui bundle imports a builtin shell or view through @fishtea/plugins
COPY plugins ./plugins
# Exactly what bun.lock says, or the build fails: a fallback to a fresh resolve made images unreproducible.
RUN bun install --frozen-lockfile

# The application directory is mounted at /app at runtime, so one image serves any spec.
FROM base AS core
# FISHTEA_HOST=0.0.0.0 so the core answers from outside the container; compose can override any of these.
ENV FISHTEA_APP=/app FISHTEA_HOME=/fishtea FISHTEA_HOST=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["bun", "packages/cli/src/index.ts", "serve", "--app", "/app"]

# The vessels, served by Vite. VITE_CORE_URL must be an address a browser can reach, not the container's.
FROM base AS ui
WORKDIR /fishtea/packages/ui
EXPOSE 5173
CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0"]
