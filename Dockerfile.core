# Core (Bun). The app directory is mounted at /app at runtime (FISHTEA_APP), so one image serves any spec.
FROM oven/bun:1 AS base
WORKDIR /fishtea
COPY package.json bun.lock* tsconfig.json ./
COPY packages ./packages
RUN bun install --frozen-lockfile || bun install
ENV FISHTEA_APP=/app PORT=3000
EXPOSE 3000
CMD ["bun", "packages/cli/src/index.ts", "serve", "--app", "/app"]

# UI: Vite dev server serving the vessels; VITE_CORE_URL points at core
FROM base AS ui
WORKDIR /fishtea/packages/ui
EXPOSE 5173
CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0"]
