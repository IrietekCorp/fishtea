# bun loads .env automatically
DATABASE_URL=postgres://fishtea:fishtea@localhost:5432/fishtea
CLASSIFIER_URL=http://localhost:8081
FISHTEA_INTENT=lexical            # lexical = dev/offline harness only (D5); needle = the product
FISHTEA_STRICT=0
FISHTEA_OPERATOR_TOKEN=change-me
FISHTEA_APP=templates/ecommerce
FISHTEA_HOST=0.0.0.0              # what the core binds; 127.0.0.1 keeps it on this machine
# FISHTEA_CORS_ORIGINS=https://shop.example   # browser origins; unset = any port on an address this core answers on
# FISHTEA_PUBLIC_HOST=192.168.1.20  # the address other machines dial; detected from the LAN when unset
# FISHTEA_WORKSPACE=~/development   # where `fishtea new` creates applications
