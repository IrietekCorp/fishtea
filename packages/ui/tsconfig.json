{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "bun"
    ],
    "baseUrl": ".",
    "paths": {
      "#generated/*": [
        "src/generated/*"
      ],
      "@fishtea/ui/*": [
        "src/*"
      ],
      "@fishtea/plugins/*": [
        "../../plugins/*"
      ],
      "@fishtea/present": [
        "../spec/src/present.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
