{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishtea.io/spec.schema.json",
  "title": "FishTea business spec",
  "type": "object",
  "required": [
    "fishtea",
    "business",
    "entities",
    "calls",
    "rules",
    "shapes",
    "personas",
    "envelope"
  ],
  "additionalProperties": false,
  "properties": {
    "fishtea": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "business": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,40}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "doc": {
          "type": "string"
        },
        "locale": {
          "type": "string",
          "default": "en-US"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "entities": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    },
    "calls": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/call"
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "doc": {
          "type": "string"
        },
        "writes": {
          "type": "object",
          "properties": {
            "confirmAlways": {
              "type": "boolean"
            },
            "minConfidence": {
              "type": "number"
            }
          }
        },
        "classify": {
          "type": "object",
          "properties": {
            "budgetMs": {
              "type": "integer"
            },
            "floor": {
              "type": "number"
            },
            "contextTurns": {
              "type": "integer"
            }
          }
        },
        "calls": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "type": "integer"
            }
          }
        },
        "familiarity": {
          "type": "object",
          "properties": {
            "threshold": {
              "type": "number"
            }
          }
        },
        "present": {
          "type": "object",
          "description": "How answers are laid out. molecules: per entity, which field is the title, eyebrow, body, link. shapes: per shape, the ordered organisms its answer is laid out as. Anything undeclared is derived from the spec. Checked in detail by present.ts.",
          "properties": {
            "doc": {
              "type": "string"
            },
            "molecules": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            },
            "shapes": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "organism"
                  ]
                }
              }
            },
            "icons": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Words an icon binding produces, mapped onto the renderer's icon vocabulary."
            }
          },
          "additionalProperties": false
        },
        "site": {
          "type": "object",
          "description": "The site map a shell navigates by: home, sections (the menu, in order), parents (where up goes), actions (shapes that open over a section), and the shell's business copy. Checked against the shapes at load (site.ts).",
          "required": [
            "home",
            "sections"
          ],
          "properties": {
            "doc": {
              "type": "string"
            },
            "home": {
              "type": "string"
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "shape",
                  "label"
                ],
                "properties": {
                  "shape": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "parents": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "actions": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "shape",
                  "label"
                ],
                "properties": {
                  "shape": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "copy": {
              "type": "object",
              "properties": {
                "ask": {
                  "type": "string"
                },
                "cta": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "lead": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "analytics": {
              "type": "object",
              "description": "Page analytics on the site's pages (never /admin). google: a GA4 measurement id, G-…. consent (default true): load nothing until the visitor accepts in a banner; false loads it at once. notice: the banner's sentence.",
              "properties": {
                "google": {
                  "type": "string",
                  "pattern": "^G-[A-Z0-9]{4,}$"
                },
                "consent": {
                  "type": "boolean"
                },
                "notice": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "suggestions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 12,
              "description": "Things a visitor might ask, in their words: the menu's rotating placeholder and its first three chips."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "shapes": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/shape"
      }
    },
    "personas": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "when"
        ],
        "properties": {
          "when": {
            "type": "string"
          },
          "doc": {
            "type": "string"
          }
        }
      }
    },
    "envelope": {
      "type": "object",
      "required": [
        "version",
        "accept",
        "greeting"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "doc": {
          "type": "string"
        },
        "accept": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "greeting": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "shape": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              },
              "resume": {
                "type": "boolean"
              },
              "offer": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "to",
          "text"
        ],
        "properties": {
          "to": {
            "type": "string",
            "enum": [
              "visitor",
              "operator"
            ]
          },
          "text": {
            "type": "string"
          },
          "doc": {
            "type": "string"
          },
          "next": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/next"
            }
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "doc": {
          "type": "string"
        },
        "shapes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/shape"
          }
        }
      }
    },
    "plugins": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "doc": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/pluginUse"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "typeString": {
      "type": "string",
      "pattern": "^(enum:[^\\s\\[\\]?=]+|[A-Za-z_][A-Za-z0-9_]*)(\\[\\])?\\??(=.*)?$"
    },
    "typeSpec": {
      "anyOf": [
        {
          "$ref": "#/$defs/typeString"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/typeString"
            },
            "optional": {
              "type": "boolean"
            },
            "default": {},
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "doc": {
              "type": "string"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/typeSpec"
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "required": [
        "fields"
      ],
      "properties": {
        "doc": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/typeSpec"
          }
        },
        "index": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "embed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unique": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "required": [
        "kind",
        "in",
        "out",
        "impl"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "query",
            "mutation",
            "compute",
            "external"
          ]
        },
        "doc": {
          "type": "string"
        },
        "in": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/typeSpec"
          }
        },
        "out": {
          "$ref": "#/$defs/typeSpec"
        },
        "impl": {
          "type": "object",
          "properties": {
            "sql": {
              "type": "string"
            },
            "module": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "doc": {
              "type": "string"
            },
            "plugin": {
              "type": "string",
              "description": "name of a plugin in spec.plugins that provides this call's implementation"
            }
          },
          "additionalProperties": false
        },
        "transaction": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "call"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "call": {
          "type": "string"
        },
        "with": {
          "type": "object"
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "next": {
      "type": "object",
      "required": [
        "shape"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "each": {
          "type": "string"
        },
        "on": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string"
            }
          },
          "description": "Fire this affordance when the named form field changes, instead of on a click. It is sent as an ordinary utterance, so it is gated, planned and recorded on the trail like any other turn."
        }
      },
      "additionalProperties": false
    },
    "shape": {
      "type": "object",
      "required": [
        "asks",
        "input",
        "answer",
        "effect",
        "allow"
      ],
      "properties": {
        "asks": {
          "type": "string",
          "minLength": 1
        },
        "doc": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/typeSpec"
          }
        },
        "answer": {
          "$ref": "#/$defs/typeSpec"
        },
        "effect": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "plan": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "assemble": {},
        "phrase": {
          "type": "string"
        },
        "vessel": {
          "type": "string",
          "enum": [
            "list",
            "card",
            "detail",
            "compare",
            "timeline",
            "confirm"
          ]
        },
        "next": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/next"
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compose": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sibling shapes whose answers pour alongside this one, as parts of a single composite. Each must be a read this persona may ask; a write is never composed, because a write pours confirm-write on its own and a composite must not hide one."
        }
      },
      "additionalProperties": false
    },
    "pluginUse": {
      "type": "object",
      "required": [
        "use"
      ],
      "properties": {
        "use": {
          "type": "string",
          "description": "where the plugin comes from: a bare name (builtin or plugins/<name>), a relative path, or an npm package"
        },
        "version": {
          "type": "string",
          "description": "semver range the plugin must satisfy"
        },
        "kind": {
          "type": "string",
          "enum": [
            "integration",
            "ui",
            "auth",
            "classifier",
            "channel",
            "archetype",
            "shell"
          ]
        },
        "config": {
          "type": "object",
          "description": "answers to the plugin's own configuration questions"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  }
}
