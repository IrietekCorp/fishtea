{
  "name": "fishtea",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "Describe a business once in JSON; derive the data layer, the classifier's tool list, the planner, the vessels and the operator console from it.",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "bin": {
    "fishtea": "./packages/cli/src/index.ts"
  },
  "scripts": {
    "fishtea": "bun packages/cli/src/index.ts",
    "derive": "bun packages/cli/src/index.ts derive",
    "validate": "bun packages/cli/src/index.ts validate",
    "headless": "bun packages/cli/src/index.ts headless",
    "dev": "bun packages/cli/src/index.ts dev",
    "tui": "bun packages/cli/src/index.ts tui",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "bench": "bun packages/cli/src/index.ts bench",
    "test": "bun test packages scripts",
    "typecheck": "bun packages/ui/scripts/ensure-generated.ts && bunx tsc -p tsconfig.json --noEmit && bunx tsc -p packages/ui/tsconfig.json --noEmit",
    "release": "bun scripts/release.ts",
    "update": "bun packages/cli/src/index.ts update",
    "build-release": "bun scripts/build-release.ts",
    "site": "bun site/build.ts",
    "e2e": "bun scripts/e2e.ts",
    "deploy": "bun run site && bunx firebase-tools deploy --only hosting --project fishtea-io",
    "ui-assets-base": "bun packages/ui/scripts/ensure-generated.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "marked": "^18.0.14",
    "typescript": "^5.6.0"
  }
}
