FROM python:3.12-slim
WORKDIR /srv
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY packages/classifier/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY packages/classifier/needle_service.py .
# weights + engine cache live on the `models` volume; HOME points there so cactus-needle finds them
ENV HOME=/models HF_HOME=/models/hf NEEDLE_TELEMETRY=0 NEEDLE_WORKERS=3 NEEDLE_PORT=8081
VOLUME ["/models"]
EXPOSE 8081
HEALTHCHECK --interval=5s --retries=60 CMD curl -fs http://localhost:8081/healthz || exit 1
CMD ["python", "needle_service.py"]
